// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Users{
  id Int @id @default(autoincrement())
  email String @unique
  phone String @unique
  password String
  firstName String
  lastName String
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  projects Projects []
}

model Projects{
  id Int @id @default(autoincrement())
  name String @unique
  description String
  // createById Int
  // createdBy Users @relation(fields: [createById],references: [id])
  // updateBy @relation(fields: [createById],references: [id])
 createAt DateTime @default(now())
  updateAt DateTime @updatedAt
  timeline DateTime
  tasks Tasks[]
  users Users[]

}
model Tasks{
  id Int @id @default(autoincrement())
  name String @unique
  description String
  dueDate DateTime
  priority TaskPriority
  status TaskStatus
  projectId Int
  project Projects @relation(fields: [projectId],references: [id])
  time DateTime
  createdAt DateTime
  updatedAt DateTime
   // createdBy Int@relation(fields: [createById],references: [id])
  // updateBy @relation(fields: [createById],references: [id])
}


enum TaskStatus{
  PENDING
  COMPLETED
  FAILED
  INPROGRESS
  CANCELLED
}

enum TaskPriority{
  LOW
  NORMAL
  HIGH
}
