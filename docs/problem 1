sol import { PrismaClient } from '@prisma/client'
import { PrismaMariaDb } from '@prisma/adapter-mariadb'
import mariadb from 'mariadb'

// 1. Create the connection pool with necessary security fallbacks
const pool = mariadb.createPool({
  host: '127.0.0.1',
  port: 3310,
  user: process.env.DB_USER,      // Your database username
  password: process.env.DB_PASSWORD,  // Your database password
  database: 'miniclickup',
  
  // CRITICAL FIXES FOR LOCAL MARIADB/MYSQL POOL TIMEOUTS:
  allowPublicKeyRetrieval: true,
  ssl: false, // Set to true if your local server strictly demands SSL
  
  connectionLimit: 10
})

// 2. Instantiate the adapter
const adapter = new PrismaMariaDb(pool)

// 3. Pass it to the client
export const prisma = new PrismaClient({ adapter })
