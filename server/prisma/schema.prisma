generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  firstName        String
  lastName         String
  phone            String?          @unique
  role             Role             @default(USER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isActive         Boolean?         @default(true)
  otp              String?
  otpExpiry        DateTime?
  isVerified       Boolean          @default(false)
  image            Bytes?           @db.ByteA
  
  assignedTasks    Tasks[]          @relation("AssignedTo")
  createdTasks     Tasks[]          @relation("AssignedBy")
  createdProjects  Projects[]       @relation("createdBy")
  updatedProjects  Projects[]       @relation("updatedBy")
  assignedProjects Projects[]       @relation("assignId")
  preference       UserPreference?
  notifications    Notifications[]  @relation("UserNotifications")
}

model SignupOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  otpExpiry DateTime
}

model ForgetpassOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  otpExpiry DateTime
}

model Projects {
  id          Int      @id @default(autoincrement())
  name        String   
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startDate   DateTime
  endDate     DateTime?
  status      Status   @default(TODO)
  isActive    Boolean? @default(true)
  
  createdBy   Int
  updatedBy   Int?
  assignId    Int?

  creator     Users    @relation("createdBy", fields: [createdBy], references: [id])
  updater     Users?   @relation("updatedBy", fields: [updatedBy], references: [id])
  assignTo    Users?   @relation("assignId", fields: [assignId], references: [id])
  tasks       Tasks[]
  files       Files[]

  @@index([createdBy])
  @@index([updatedBy])
}

model UserPreference {
  id           Int     @id @default(autoincrement())
  theme        String  @default("light")
  notification String?
  
  userId       Int     @unique
  user         Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notifications {
  id           Int      @id @default(autoincrement())
  notification String
  from         Int
  isRead       Boolean? @default(false)
  createdAt    DateTime @default(now())
  
  userId       Int
  user         Users    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Files {
  id         Int       @id @default(autoincrement())
  location   String    @unique
  projectsId Int?
  projects   Projects? @relation(fields: [projectsId], references: [id], onDelete: Cascade)

  @@index([projectsId])
}

model Tasks {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  time        DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  startDate   DateTime
  endDate     DateTime
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(PENDING)
  
  // Foreign Keys
  projectId   Int
  assignedBy  Int?
  assignedTo  Int?

  // Relations
  project     Projects     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Users?       @relation("AssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  assigner    Users?       @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assignedTo])
  @@index([assignedBy])
}

enum TaskStatus {
  PENDING
  COMPLETED
  FAILED
  INPROGRESS
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum Role {
  ADMIN
  SUPERADMIN
  USER
}

enum Status {
  TODO
  INPROGRESS
  COMPLETED
  CANCELLED
}
